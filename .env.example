# ============================================================
#  Voide Warframe — environment variables
#  Copy to .env and fill in. NEVER commit the real .env file.
# ============================================================

# --- Database (PostgreSQL) ---------------------------------
# Local docker-compose: postgresql://voidwf:voidwf@localhost:5432/voidwf
# Railway: provided automatically as ${{ Postgres.DATABASE_URL }}
DATABASE_URL="postgresql://voidwf:voidwf@localhost:5432/voidwf?schema=public"

# --- Server -------------------------------------------------
# Railway injects PORT automatically. Leave default for local.
PORT=3000
NODE_ENV=development

# --- External Warframe API ---------------------------------
WARFRAME_API_BASE="https://api.warframestat.us"
WARFRAME_PLATFORM="pc"
# Server-side cache TTL for worldstate, in seconds.
WARFRAME_CACHE_TTL=60

# --- AI provider (optional) --------------------------------
# Supported AI_PROVIDER values: "anthropic" | "openai" | "none"
AI_PROVIDER="none"
AI_API_KEY=""
# Model id, e.g. claude-opus-4-7 for Anthropic, gpt-4o for OpenAI.
AI_MODEL="claude-opus-4-7"

# --- File uploads ------------------------------------------
# Directory for stored files. On Railway, mount a Volume here.
UPLOAD_DIR="./uploads"
# Max upload size in bytes (default 10 MB).
UPLOAD_MAX_BYTES=10485760

# --- App ----------------------------------------------------
# Public base URL of the deployed site (used for absolute links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
